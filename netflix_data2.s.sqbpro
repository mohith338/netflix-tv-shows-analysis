SELECT *from netflix_analysis;

select count(*) as total_count from netflix_analysis;

SELECT distinct rating as unique_rating FROM netflix_analysis;

select year as total_years from netflix_analysis group by year order by total_years;

select year,count(*) as total_years from netflix_analysis group by year order by total_years;

select imdb_rating as total_count from netflix_analysis group by imdb_rating order by total_count DESC LIMIT 10;

select imdb_rating,count(*) as total_count from netflix_analysis group by imdb_rating order by total_count DESC LIMIT 10;

select imdb_rating as total_count from netflix_analysis group by imdb_rating order by total_count ASC LIMIT 10;

select imdb_rating,count(*) as total_count from netflix_analysis group by imdb_rating order by total_count ASC LIMIT 10;

select titles as total_titles from netflix_analysis group by titles order by total_titles DESC limit 10;

select titles as total_titles from netflix_analysis group by titles order by total_titles ASC limit 10;

select avg(imdb_rating) from netflix_analysis;

select min(imdb_rating) from netflix_analysis;

select max(imdb_rating) from netflix_analysis;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
